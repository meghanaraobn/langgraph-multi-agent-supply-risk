# LLM provider (Azure AI Foundry v1 API -- OpenAI-SDK-compatible, no api-version needed)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# App
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Postgres (see docker/postgres/Dockerfile)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplyguard
POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://supplyguard:changeme@localhost:5432/supplyguard

# LangGraph / checkpointing
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# RAG / Weaviate (see docker-compose.yml's weaviate service)
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5

# MCP
MCP_SERVER_PORT=8100

# Observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=supplyguard-ai
